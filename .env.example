ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1

# Docker host interface for published port. Default is local-only IPv4 loopback.
# DOCKER_BIND_ADDRESS=127.0.0.1
# Set DOCKER_BIND_ADDRESS=0.0.0.0 for explicit LAN/server access.
# WEB_PORT changes only the host-side port; container application port remains 6969.
# WEB_PORT=8080

# Docker host directory mounted at /app/runtime. Default: ./runtime.
# DOCKER_RUNTIME_DIR=./runtime
# RUNTIME_DIR, AUTH_STATE_DIR, and CONVERSATION_SNAPSHOT_DB control native runs only.
